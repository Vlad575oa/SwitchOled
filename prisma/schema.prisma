generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id       Int        @id @default(autoincrement())
  name     String
  slug     String     @unique
  parentId Int?
  parent   Category?  @relation("sub", fields: [parentId], references: [id])
  children Category[] @relation("sub")
  products Product[]
}

model Product {
  id          Int         @id @default(autoincrement())
  name        String
  slug        String      @unique
  sku         String?
  description String?
  price       Int
  priceOld    Int?
  showOtherPaymentPrice Boolean @default(false)
  images      String[]
  inStock     Boolean     @default(true)
  isNew       Boolean     @default(false)
  isSale      Boolean     @default(false)
  color       String?
  colorHex    String?
  brand       String?
  attributes  Json?
  categoryId  Int
  metaTitle   String?
  metaDesc    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  stock       Int         @default(10)
  isVisible   Boolean     @default(true)
  orderItems  OrderItem[]
  wishlistItems WishlistItem[]
  category    Category    @relation(fields: [categoryId], references: [id])

  @@index([slug])
  @@index([price])
  @@index([categoryId])
  @@index([inStock])
}

model Order {
  id          Int         @id @default(autoincrement())
  status      String      @default("pending")
  totalAmount Int
  name        String
  phone       String
  address     String
  comment     String?
  paymentId   String?     @unique
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  userId      Int?
  user        User?       @relation(fields: [userId], references: [id])
  items       OrderItem[]
}

model OrderItem {
  id                Int     @id @default(autoincrement())
  orderId           Int
  productId         Int
  product_name_at_purchase String
  quantity          Int
  price_at_purchase Int
  order             Order   @relation(fields: [orderId], references: [id])
  product           Product @relation(fields: [productId], references: [id])
}

model Post {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String
  image       String?
  isPublished Boolean  @default(false)
  metaTitle   String?
  metaDesc    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    String?  @default("Статья")

  @@index([slug])
}

model FAQ {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  category  String   @default("Заказы")
}

model User {
  id            Int       @id @default(autoincrement())
  email         String?   @unique
  phone         String?   @unique
  name          String?
  passwordHash  String?
  passwordSalt  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  emailVerified DateTime?
  lastLogin     DateTime?
  role          String    @default("USER")
  Account       Account[]
  orders        Order[]
  sessions      Session[]
  wishlistItems WishlistItem[]

  @@index([email])
  @@index([phone])
}

model WishlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@index([productId])
}

model Session {
  id           String   @id
  userId       Int
  createdAt    DateTime @default(now())
  expires      DateTime
  sessionToken String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                String  @id
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  User              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PageContent {
  id        String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model CartEvent {
  id        Int      @id @default(autoincrement())
  productId Int
  source    String   // "catalog_grid" | "product_page"
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([productId])
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  topic     String
  message   String
  createdAt DateTime @default(now())
}

model Color {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  hex   String
}

model ChatSession {
  id         String        @id @default(cuid())
  visitorId  String
  name       String?
  email      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  isResolved Boolean       @default(false)
  messages   ChatMessage[]
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  content   String
  sender    String      // "USER" | "ADMIN"
  createdAt DateTime    @default(now())
  isRead    Boolean     @default(false)
}

model PriceSupplier {
  id            Int      @id @default(autoincrement())
  slug          String   @unique
  name          String
  detectPattern Json
  parserKey     String
  createdAt     DateTime @default(now())

  uploads       PriceUpload[]
}

model PriceUpload {
  id           Int           @id @default(autoincrement())
  supplierId   Int
  supplier     PriceSupplier @relation(fields: [supplierId], references: [id])
  fileName     String
  fileHash     String
  priceDate    DateTime?
  status       String        @default("processing") // "processing" | "done" | "failed"
  rowsTotal    Int           @default(0)
  rowsMatched  Int           @default(0)
  rowsPending  Int           @default(0)
  uploadedBy   String?
  createdAt    DateTime      @default(now())

  entries      PriceEntry[]

  @@index([supplierId, fileHash])
  @@index([supplierId, createdAt])
}

model Game {
  id            Int         @id @default(autoincrement())
  canonicalName String
  platform      String
  region        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  aliases       GameAlias[]
  entries       PriceEntry[]

  @@unique([canonicalName, platform, region])
  @@index([platform])
}

model GameAlias {
  id         Int      @id @default(autoincrement())
  gameId     Int
  game       Game     @relation(fields: [gameId], references: [id])
  rawText    String
  normalized String
  // Денормализовано из Game.platform: то же название игры существует как отдельные
  // записи на разных платформах (PS4/PS5/SWITCH/...), и alias должен быть уникален
  // в пределах платформы, а не глобально — иначе строка прайса с платформы A может
  // случайно сопоставиться с игрой на платформе B при совпадении названия.
  // "" — платформа не определена парсером (редкий случай, отдельный бакет).
  platform   String
  source     String   @default("ai") // "ai" | "manual" | "exact"
  createdAt  DateTime @default(now())

  @@unique([normalized, platform])
  @@index([gameId])
}

model PriceEntry {
  id             Int         @id @default(autoincrement())
  uploadId       Int
  upload         PriceUpload @relation(fields: [uploadId], references: [id])
  gameId         Int?
  game           Game?       @relation(fields: [gameId], references: [id])

  rawName        String
  normalizedName String
  platform       String?
  sku            String?

  priceRetail    Int?
  priceWholesale Int?
  inStock        Boolean     @default(true)

  matchStatus    String      @default("pending") // "pending" | "auto" | "confirmed" | "rejected"
  matchScore     Float?

  createdAt      DateTime    @default(now())

  @@index([uploadId])
  @@index([gameId])
  @@index([normalizedName])
  @@index([matchStatus])
}
